CompileFlags:
  CompilationDatabase: "esp8266_firmware/build"
  Remove:
    - -free
    - -fipa-pta
    - -mlongcalls
    - -mtext-section-literals
  Add:
    - -Qunused-arguments
    - -Wno-unknown-argument
    - -w

Diagnostics:
  Suppress:
    - pp_file_not_found
    - undeclared_var_use
    - unknown_typename
    - drv_compilation_fail
    - drv_unknown_argument
    - unknown-argument
